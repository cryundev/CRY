<Window x:Class="Editor_WPF.AssetImport.AssetImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Style="{StaticResource ProjectBrowserDialogStyle}"
        Title="Asset Import"
        Width="900" Height="620"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Border Margin="10" HorizontalAlignment="Stretch"
            Background="{StaticResource Editor.Window.GrayBrush3}"
            CornerRadius="3">
        <Border.Effect>
            <DropShadowEffect Opacity="0.6" BlurRadius="15" ShadowDepth="2" />
        </Border.Effect>

        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="132" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="DialogTitleTextBlock"
                               FontSize="20" FontWeight="SemiBold"
                               Foreground="{StaticResource Editor.FontBrush}" />

                    <TextBlock x:Name="DialogDescriptionTextBlock" Margin="0,6,0,0"
                               Foreground="{StaticResource Editor.Disable.FontBrush}" />
                </StackPanel>

                <Border Grid.Column="1" Height="28" MinWidth="112" HorizontalAlignment="Right"
                        Background="{StaticResource Editor.Window.GrayBrush4}"
                        CornerRadius="3">
                    <TextBlock x:Name="AssetTypeTextBlock"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Editor.FontBrush}" />
                </Border>
            </Grid>

            <!-- Body: source preview and import options -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <!-- Source -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="240" />
                        <RowDefinition Height="12" />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{StaticResource Editor.Window.GrayBrush2}"
                            BorderBrush="{StaticResource Editor.Window.GrayBrush4}"
                            BorderThickness="1" CornerRadius="3">
                        <Grid>
                            <Image x:Name="PreviewImage" Margin="8"
                                   Stretch="Uniform" Visibility="Collapsed" />

                            <StackPanel x:Name="PrimitivePreviewPanel"
                                        Margin="18" VerticalAlignment="Center">
                                <TextBlock Text="CRY"
                                           HorizontalAlignment="Center"
                                           FontSize="34" FontWeight="Bold"
                                           Foreground="{StaticResource Editor.BlueBrush}" />

                                <TextBlock Text="Primitive" Margin="0,6,0,0"
                                           HorizontalAlignment="Center"
                                           Foreground="{StaticResource Editor.FontBrush}" />

                                <TextBlock x:Name="PrimitiveExtensionTextBlock" Margin="0,2,0,0"
                                           HorizontalAlignment="Center"
                                           Foreground="{StaticResource Editor.Disable.FontBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Padding="12"
                            Background="{StaticResource Editor.Window.GrayBrush2}"
                            BorderBrush="{StaticResource Editor.Window.GrayBrush4}"
                            BorderThickness="1" CornerRadius="3">
                        <StackPanel>
                            <TextBlock Text="Source" FontWeight="SemiBold"
                                       Foreground="{StaticResource Editor.FontBrush}" />

                            <TextBlock x:Name="SourceNameTextBlock" Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource Editor.FontBrush}" />

                            <TextBlock x:Name="SourcePathTextBlock" Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource Editor.Disable.FontBrush}" />

                            <TextBlock x:Name="SourceDetailTextBlock" Margin="0,10,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource Editor.Disable.FontBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <!-- Output -->
                    <Border Grid.Row="0" Padding="16"
                            Background="{StaticResource Editor.Window.GrayBrush2}"
                            BorderBrush="{StaticResource Editor.Window.GrayBrush4}"
                            BorderThickness="1" CornerRadius="3">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Output"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Editor.FontBrush}" />

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="112" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="76" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Project Path"
                                           Style="{StaticResource LightTextBlockStyle}" />

                                <TextBox Grid.Column="1" x:Name="DestinationPathTextBox"
                                         TextChanged="OnDestinationPathTextBoxTextChanged" />

                                <Button Grid.Column="2" Content="Browse"
                                        Width="64" Margin="12,0,0,0"
                                        Click="OnBrowseDestinationButtonClicked" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Texture settings -->
                    <Border Grid.Row="1" x:Name="TextureOptionsPanel"
                            Margin="0,12,0,0" Padding="16"
                            Background="{StaticResource Editor.Window.GrayBrush2}"
                            BorderBrush="{StaticResource Editor.Window.GrayBrush4}"
                            BorderThickness="1" CornerRadius="3">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Texture Settings"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Editor.FontBrush}" />

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="112" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="112" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Size"
                                           Style="{StaticResource LightTextBlockStyle}" />

                                <ComboBox Grid.Column="1" Grid.ColumnSpan="4"
                                          x:Name="TextureSizeModeComboBox"
                                          SelectionChanged="OnTextureOptionChanged" />
                            </Grid>

                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="112" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="112" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Width"
                                           Style="{StaticResource LightTextBlockStyle}" />

                                <ComboBox Grid.Column="1" x:Name="TextureWidthComboBox"
                                          SelectionChanged="OnTextureOptionChanged" />

                                <TextBlock Grid.Column="3" Text="Height"
                                           Style="{StaticResource LightTextBlockStyle}" />

                                <ComboBox Grid.Column="4" x:Name="TextureHeightComboBox"
                                          SelectionChanged="OnTextureOptionChanged" />
                            </Grid>

                            <Grid Grid.Row="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="112" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="112" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Color Space"
                                           Style="{StaticResource LightTextBlockStyle}" />

                                <ComboBox Grid.Column="1" x:Name="TextureColorSpaceComboBox"
                                          SelectionChanged="OnTextureOptionChanged" />

                                <TextBlock Grid.Column="3" Text="Compression"
                                           Style="{StaticResource LightTextBlockStyle}" />

                                <ComboBox Grid.Column="4" x:Name="TextureCompressionComboBox"
                                          SelectionChanged="OnTextureOptionChanged" />
                            </Grid>

                            <Grid Grid.Row="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="112" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="112" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Mipmaps"
                                           Style="{StaticResource LightTextBlockStyle}" />

                                <CheckBox Grid.Column="1" Grid.ColumnSpan="4"
                                          x:Name="GenerateMipmapsCheckBox"
                                          Content="Generate mip chain"
                                          Foreground="{StaticResource Editor.FontBrush}"
                                          Checked="OnTextureOptionChanged"
                                          Unchecked="OnTextureOptionChanged" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Primitive settings -->
                    <Border Grid.Row="1" x:Name="PrimitiveOptionsPanel"
                            Margin="0,12,0,0" Padding="16"
                            Background="{StaticResource Editor.Window.GrayBrush2}"
                            BorderBrush="{StaticResource Editor.Window.GrayBrush4}"
                            BorderThickness="1" CornerRadius="3">
                        <DockPanel>
                            <TextBlock Text="Source Type" Width="112"
                                       Style="{StaticResource LightTextBlockStyle}" />

                            <TextBlock Text ="CRY primitive asset"
                                       Style="{StaticResource LightTextBlockStyle}" />
                        </DockPanel>
                    </Border>

                    <!-- Summary -->
                    <Border Grid.Row="2" Margin="0,12,0,0" Padding="16"
                            Background="{StaticResource Editor.Window.GrayBrush2}"
                            BorderBrush="{StaticResource Editor.Window.GrayBrush4}"
                            BorderThickness="1" CornerRadius="3">
                        <StackPanel>
                            <TextBlock Text="Import Summary" FontWeight="SemiBold"
                                       Foreground="{StaticResource Editor.FontBrush}" />

                            <TextBlock x:Name="OutputSummaryTextBlock" Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource Editor.Disable.FontBrush}" />

                            <TextBlock x:Name="MessageTextBlock" Margin="0,10,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource Editor.Disable.FontBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- Actions -->
            <StackPanel Grid.Row="3" Margin="0,22,0,0"
                        Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ImportButton" Content="Import"
                        Width="76" Margin="0,0,12,0"
                        IsDefault="True"
                        Click="OnImportButtonClicked" />

                <Button Content="Cancel" Width="76" IsCancel="True" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
