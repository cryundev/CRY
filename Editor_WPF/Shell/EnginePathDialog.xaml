<Window x:Class="Editor_WPF.Shell.EnginePathDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Style="{StaticResource ProjectBrowserDialogStyle}"
        Title="CRY Engine Path" Width="400" Height="250"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Border Margin="10" HorizontalAlignment="Stretch"
            Background="{StaticResource Editor.Window.GrayBrush3}"
            CornerRadius="3">
        <Border.Effect>
            <DropShadowEffect Opacity="0.6" BlurRadius="15" ShadowDepth="2" />
        </Border.Effect>

        <Grid Margin="32,0">
            <TextBlock x:Name="MessageTextBlock"
                       Margin="0,10,0,0"
                       HorizontalAlignment="Center" VerticalAlignment="Top"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource Editor.RedBrush}" />

            <DockPanel>
                <TextBlock Text="Engine Path" Width="72" Style="{StaticResource LightTextBlockStyle}" />
                <TextBox x:Name="PathTextBox" />
            </DockPanel>

            <StackPanel Margin="0,0,0,20"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button Content="Ok" Width="64" Margin="32,0" IsDefault="True" Click="OnOkButtonClicked" />
                <Button Content="Cancel" Width="64" IsCancel="True" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
