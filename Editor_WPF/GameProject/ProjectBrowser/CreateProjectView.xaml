<UserControl x:Class="Editor_WPF.GameProject.ProjectBrowser.CreateProjectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:gameProject="clr-namespace:Editor_WPF.GameProject"
             mc:Ignorable="d"
             Width="800"
             d:DataContext="{d:DesignInstance Type=gameProject:CreateProjectViewModel, IsDesignTimeCreatable=True}"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.DataContext>
        <gameProject:CreateProjectViewModel />
    </UserControl.DataContext>

    <Border Width="700" Margin="0,30" HorizontalAlignment="Center"
            Background="{StaticResource Editor.Window.GrayBrush3}"
            CornerRadius="3">
        <StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <ListBox x:Name="templateListBox"
                         Width="195" Height="250"
                         ItemsSource="{Binding ProjectTemplates}"
                         SelectedIndex="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{Binding Icon}" Width="40" Height="40" Margin="0,0,5,0" />
                                <TextBlock Text="{Binding ProjectType}" FontSize="16" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Width="400" Height="250" Margin="5,0,0,0">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding Path=SelectedItem.Preview, ElementName=templateListBox}" />
                    </Border.Background>
                </Border>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,30,0,0">
                <TextBlock Text="Name" Width="50" Style="{StaticResource LightTextBlockStyle}" />
                <TextBox Width="550" Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                <TextBlock Text="Path" Width="50" Style="{StaticResource LightTextBlockStyle}" />
                <TextBox Width="500" Text="{Binding ProjectPath, UpdateSourceTrigger=PropertyChanged}" />
                <Button Content="Browse" Width="45" Margin="5,0,0,0" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,30,0,0">
                <Button Content="Create" Width="95"
                        IsDefault="True"
                        IsEnabled="{Binding IsValid}"
                        Click="OnCreateButtonClick" />

                <Button Content="Exit" Width="95" Margin="30,0,0,0" IsCancel="True" />
            </StackPanel>

            <TextBlock Text="{Binding ErrorMsg}" Margin="0,20,0,0"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource Editor.RedBrush}" />
        </StackPanel>
    </Border>
</UserControl>
