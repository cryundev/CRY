<Application x:Class                     ="Editor_WPF.App"
             xmlns                       ="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x                     ="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri                  ="Shell/MainWindow.xaml"
             DispatcherUnhandledException="App_DispatcherUnhandledException">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Resources/Styles/EditorColors.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Resources/Styles/ControlTemplates.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Resources/Styles/MainWindowStyle.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Resources/Styles/ProjectBrowserDialogStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
