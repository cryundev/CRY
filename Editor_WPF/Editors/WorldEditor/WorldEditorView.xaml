<UserControl x:Class="Editor_WPF.Editors.WorldEditor.WorldEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Editor_WPF.Editors.WorldEditor"
             xmlns:assetBrowser="clr-namespace:Editor_WPF.AssetBrowser"
             xmlns:panel="clr-namespace:Editor_WPF.Panels"
             xmlns:control="clr-namespace:Editor_WPF.Controls"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             Focusable="True"
             d:DesignHeight="1080" d:DesignWidth="1920">

    <UserControl.Resources>
        <sys:Boolean x:Key="True">True</sys:Boolean>
        <sys:Boolean x:Key="False">False</sys:Boolean>

        <Style x:Key="EditorMenuItemStyle" TargetType="{x:Type MenuItem}">
            <Setter Property="Foreground"          Value="{StaticResource Editor.FontBrush}" />
            <Setter Property="Background"          Value="{StaticResource Editor.Window.GrayBrush2}" />
            <Setter Property="BorderBrush"         Value="Transparent" />
            <Setter Property="Padding"             Value="12,4" />
            <Setter Property="SnapsToDevicePixels" Value="True" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Grid x:Name="Root" Background="Transparent" SnapsToDevicePixels="True">
                            <Border x:Name         ="ItemBorder"
                                    Background     ="{TemplateBinding Background}"
                                    BorderBrush    ="{TemplateBinding BorderBrush}"
                                    BorderThickness="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="18" />
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter x:Name             ="HeaderPresenter"
                                                      ContentSource      ="Header"
                                                      Margin             ="{TemplateBinding Padding}"
                                                      RecognizesAccessKey="True"
                                                      VerticalAlignment  ="Center" />

                                    <Path x:Name="SubmenuArrow" Grid.Column="1"
                                          Data="M 0 0 L 4 4 L 0 8"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                                          StrokeThickness="1"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Visibility="Collapsed" />
                                </Grid>
                            </Border>

                            <Popup x:Name="PART_Popup"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                   AllowsTransparency="True" Focusable="False"
                                   Placement="Bottom" PopupAnimation="Fade">
                                <Border MinWidth="150" Padding="2"
                                        Background="{StaticResource Editor.Window.GrayBrush3}"
                                        BorderBrush="{StaticResource Editor.Window.GrayBrush5}"
                                        BorderThickness="1">
                                    <ScrollViewer CanContentScroll             ="True"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility  ="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="Role" Value="TopLevelHeader">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Editor.Window.GrayBrush2}" />
                                <Setter TargetName="PART_Popup" Property="Placement"  Value="Bottom" />
                                <Setter Property="Padding" Value="12,4" />
                            </Trigger>

                            <Trigger Property="Role" Value="TopLevelItem">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Editor.Window.GrayBrush2}" />
                                <Setter Property="Padding" Value="12,4" />
                            </Trigger>

                            <Trigger Property="Role" Value="SubmenuHeader">
                                <Setter TargetName="ItemBorder"   Property="Background" Value="{StaticResource Editor.Window.GrayBrush3}" />
                                <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible" />
                                <Setter TargetName="PART_Popup"   Property="Placement"  Value="Right" />
                                <Setter Property="Padding" Value="16,6" />
                            </Trigger>

                            <Trigger Property="Role" Value="SubmenuItem">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Editor.Window.GrayBrush3}" />
                                <Setter Property="Padding" Value="16,6" />
                            </Trigger>

                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Editor.Selected.BackgroundBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>

                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Editor.Selected.BackgroundBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource Editor.Disable.FontBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Command="{Binding UndoCommand}" Key="Z" Modifiers="Ctrl" />
        <KeyBinding Command="{Binding RedoCommand}" Key="Y" Modifiers="Ctrl+Shift" />
        <KeyBinding Command="{Binding SaveCommand}" Key="S" Modifiers="Ctrl" />
        <KeyBinding Command="{Binding BuildCommand}" Key="F7" />
    </UserControl.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="26" />
            <RowDefinition Height="32" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <!-- Menu bar -->
        <Menu Grid.Row          ="0"
              Background        ="{StaticResource Editor.Window.GrayBrush2}"
              Foreground        ="{StaticResource Editor.FontBrush}"
              ItemContainerStyle="{StaticResource EditorMenuItemStyle}">
            <MenuItem Header="_File">
                <MenuItem Header="_Save" Command="{Binding SaveCommand}" />
                <MenuItem Header="_Build" Command="{Binding BuildCommand}" CommandParameter="{StaticResource True}" />
            </MenuItem>

            <MenuItem Header="_Asset">
                <MenuItem Header="_Import..." Click="OnAssetImportMenuItemClicked" />
            </MenuItem>
        </Menu>

        <!-- Toolbar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <Button Content="Undo" Command="{Binding UndoCommand}" />
            <Button Content="Redo" Command="{Binding RedoCommand}" Margin="5,0,0,0" />

            <Button Content="New Script" Margin="5,0,0,0"
                    Click="OnNewScriptButtonClicked"
                    IsEnabled="{Binding Path=IsEnabled, ElementName=BuildButton}" />

            <Button x:Name="BuildButton" Content="Build" Margin="5,0,0,0"
                    Command="{Binding BuildCommand}"
                    CommandParameter="{StaticResource True}" />

            <ComboBox x:Name="RunConfig" Width="72" Margin="5,0" VerticalAlignment="Center"
                      SelectedIndex="{Binding BuildConfig}">
                <ComboBoxItem Content="Debug" />
                <ComboBoxItem Content="Release" />
            </ComboBox>
        </StackPanel>

        <!-- Main editor split -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <control:EngineViewportHost x:Name="EngineViewport" />

                <GridSplitter Grid.Row="1" Height="5"
                              HorizontalAlignment="Stretch" VerticalAlignment="Top"
                              Background="Transparent" />

                <Grid Grid.Row="1" Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <panel:UndoRedoView Grid.Column="0"
                                       DataContext="{Binding UndoRedo}"
                                       Background ="{StaticResource Editor.Window.GrayBrush2}" />

                    <GridSplitter Grid.Column="1" Width="5"
                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                  Background="Transparent" />

                    <panel:LoggerView Grid.Column="2" />
                </Grid>
            </Grid>

            <GridSplitter Grid.Column="1" Width="5"
                          HorizontalAlignment="Left" VerticalAlignment="Stretch"
                          Background="Transparent" />

            <Grid Grid.Column="1" Margin="5,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition Height="5" />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <assetBrowser:AssetFolderView Grid.Column="0" Grid.Row="0"
                                              Background="{StaticResource Editor.Window.GrayBrush3}" />

                <GridSplitter Grid.Column="0" Grid.Row="1" Height="5"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              ResizeDirection="Rows"
                              ResizeBehavior ="PreviousAndNext"
                              Background="Transparent" />

                <local:ProjectLayoutView Grid.Column="0" Grid.Row="2"
                                         Background="{StaticResource Editor.Window.GrayBrush3}" />

                <GridSplitter Grid.Column="1" Grid.RowSpan="3" Width="5"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              Background="Transparent" />

                <local:ActorView Grid.Column="2" Grid.RowSpan="3"
                                 Background="{StaticResource Editor.Window.GrayBrush3}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
