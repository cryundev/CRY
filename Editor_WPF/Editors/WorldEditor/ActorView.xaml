<UserControl x:Class="Editor_WPF.Editors.ActorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Editor_WPF.Editors"
             xmlns:component="clr-namespace:Editor_WPF.Components"
             xmlns:objects="clr-namespace:Editor_WPF.Objects"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=objects:MultiSelectionActor, IsDesignTimeCreatable=True}"
             d:DesignHeight="300" d:DesignWidth="300">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type component:MultiSelectionTransform}">
            <local:CrTransformView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type component:MultiSelectionScript}">
            <local:CrScriptView />
        </DataTemplate>
        <ContextMenu x:Key="addComponentMenu"
                     IsOpen="{Binding Path=IsChecked, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ToggleButton}}}">
            <MenuItem Header="Geometry" />
            <MenuItem Header="Physics">
                <MenuItem Header="Rigidbody" />
            </MenuItem>
            <MenuItem Header="Script" ItemsSource="{Binding SelectedActors[0].ParentWorld.Project.AvailableScripts }">
                <MenuItem.Style>
                    <Style TargetType="{x:Type MenuItem}">
                        <Setter Property="Padding" Value="5,3,2,3" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedActors[0].ParentWorld.Project.AvailableScripts}" Value="{x:Null}">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
                <MenuItem.ItemContainerStyle>
                    <Style TargetType="{x:Type MenuItem}">
                        <Setter Property="Padding" Value="5,3,2,3" />
                        <Setter Property="Header" Value="{Binding}" />
                        <EventSetter Event="Click" Handler="OnAddScriptComponent" />
                    </Style>
                </MenuItem.ItemContainerStyle>
            </MenuItem>
        </ContextMenu>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ScrollViewer.Style>
            <Style TargetType="ScrollViewer">
                <Style.Triggers>
                    <Trigger Property="DataContext" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ScrollViewer.Style>
        <StackPanel Background="{StaticResource Editor.Window.GrayBrush4}">
            <Border Height="32" Background="{StaticResource Editor.Window.GrayBrush3}">
                <ToggleButton x:Name="addComponent" VerticalAlignment="Center" HorizontalAlignment="Left" 
                              ClickMode="Press" Focusable="False" 
                              PreviewMouseLeftButtonDown="OnAddComponentPreviewMouseLeftButtonDowned" Margin="5,0,0,0">
                    <ToggleButton.Content>
                        <DockPanel>
                            <TextBlock Text="Add Compnent" Margin="5,0"/>
                            <Path Margin="3,0,2,0" Data="M0,0 L6,6 L12,0 L6,3 z" HorizontalAlignment="Center" Fill="Black" VerticalAlignment="Center"/>
                        </DockPanel>
                    </ToggleButton.Content>
                </ToggleButton>
            </Border>
            <Grid Margin="0,1" Background="{StaticResource Editor.Window.GrayBrush3}" SnapsToDevicePixels="True" Height="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="78"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Name" Style="{StaticResource LightTextBlockStyle}" Grid.Column="0" Margin="5,0,0,0"/>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=Explicit}" Grid.Column="1" 
                         GotKeyboardFocus="OnNameTextBoxKeyboardFocusGot"
                         LostKeyboardFocus="OnNameTextBoxKeyboardFocusLost" />
                <StackPanel Orientation="Horizontal" Grid.Column="2">
                    <TextBlock Text="Enabled" Margin="5,0,0,0"/>
                    <CheckBox IsChecked="{Binding IsEnabled, Mode=OneWay}" Click="OnIsEnabledCheckBoxClicked" Margin="5,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
            <ItemsControl ItemsSource="{Binding Components}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
